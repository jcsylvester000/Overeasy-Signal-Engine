# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS: used by ingest, webhooks, jobs and Vault. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
APP_URL=http://localhost:3000
# Brand shown when no partner/org brand applies (white-label default). Keep neutral.
PLATFORM_APP_NAME=Signal Engine
# 32 random bytes, base64: openssl rand -base64 32   (encrypts raw PII and webhook secrets)
OSE_ENCRYPTION_KEY=
# Random string for hashing visitor/IP data
OSE_HASH_PEPPER=

# --- Connectors ---
# Global ceiling: dry_run (build + validate payloads, send nothing) | test (Google validateOnly / Microsoft sandbox) | live
CONNECTOR_MODE=dry_run

# GoHighLevel Marketplace app (after approval)
GHL_CLIENT_ID=
GHL_CLIENT_SECRET=
# PEM public key GHL publishes for X-GHL-Signature (Ed25519)
GHL_WEBHOOK_PUBLIC_KEY=

# Google (after OAuth verification + Ads API access)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Advertising
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_DEVELOPER_TOKEN=

# Google Ads API (spend reporting + conversion-action setup). Confirm the current version before live.
GOOGLE_ADS_API_VERSION=v22
GOOGLE_ADS_DEVELOPER_TOKEN=

# --- White-label custom domains (Netlify API: personal access token + this site's ID) ---
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=

# --- Email (weekly summaries) via Resend; sender comes from the organization brand, else REPORT_FROM ---
RESEND_API_KEY=
REPORT_FROM=

# --- Inngest (optional on staging; without keys, jobs run inline after each request) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
