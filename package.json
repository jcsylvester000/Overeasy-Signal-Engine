{
  "name": "signal-engine",
  "version": "0.1.0",
  "private": true,
  "description": "White-label lead signal engine: score every lead, follow it through the CRM, send stage values to Google and Microsoft Ads.",
  "scripts": {
    "dev": "npm run build:tag && next dev",
    "build": "npm run build:tag && next build",
    "build:tag": "node scripts/build-tag.mjs",
    "build:netlify": "npm run build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:sql": "node scripts/test-sql.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "bootstrap": "node --experimental-strip-types --no-warnings scripts/bootstrap.ts",
    "inngest:dev": "npx inngest-cli@latest dev -u http://localhost:3000/api/inngest"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "clsx": "^2.1.1",
    "inngest": "^4.21.0",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@netlify/plugin-nextjs": "^5.16.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
